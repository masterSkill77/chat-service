#!/usr/bin/env node

/**
 * Module dependencies.
 */
require("dotenv").config();
var app = require("../app");

var debug = require("debug")("chat-service:server");
var http = require("http");
const { Server } = require("socket.io");
const { saveMessage } = require("../services/messageService");
const { areFriends } = require("../services/friendshipService");

// Profil public de l'émetteur : jamais l'e-mail ni les quotas
function publicUser(user) {
  return { id: user.id, name: user.name, lastname: user.lastname, username: user.username };
}

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || "4001");
app.set("port", port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(bind + " requires elevated privileges");
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(bind + " is already in use");
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
  debug("Listening on " + bind);
}
const io = new Server(server, {
  cors: {
    origin: process.env.CORS_ALLOWED_ORIGINS || "http://localhost:5180",
  },
});

// Authentification : le token Sanctum est vérifié auprès de Laravel.
// L'identité retenue est celle renvoyée par Laravel, jamais celle envoyée par le client.
io.use(async (socket, next) => {
  const token = socket.handshake.auth && socket.handshake.auth.token;
  if (!token) return next(new Error("unauthorized"));

  try {
    const response = await fetch(process.env.AUTH_USER_URL, {
      headers: { Authorization: `Bearer ${token}`, Accept: "application/json" },
    });
    if (!response.ok) return next(new Error("unauthorized"));
    socket.data.user = await response.json();
    next();
  } catch (error) {
    next(new Error("unauthorized"));
  }
});

io.on("connection", (socket) => {
  const me = String(socket.data.user.id);

  socket.on("client_join", () => {
    socket.join(me);
    io.to(me).emit("joined");
  });
  // Enregistre le message, le transmet au destinataire et renvoie le message enregistré à l'émetteur
  socket.on("send_message", async (data, ack) => {
    try {
      // Messagerie réservée aux amis confirmés
      if (!(await areFriends(me, data.toUser.id))) {
        if (typeof ack === "function") ack({ ok: false, error: "NOT_FRIENDS" });
        return;
      }
      const saved = await saveMessage(data.toUser.id, me, data.message, "TEXT");
      io.to(String(data.toUser.id)).emit("message_received", {
        from: publicUser(socket.data.user),
        message: saved,
      });
      if (typeof ack === "function") ack({ ok: true, message: saved });
    } catch (error) {
      if (typeof ack === "function") ack({ ok: false });
    }
  });
});
